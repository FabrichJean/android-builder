# Port d'écoute du serveur HTTP
PORT=8080

# Token GitHub (PAT classique ou fine-grained) avec la permission
# "Actions: read and write" sur le dépôt ci-dessous.
GITHUB_TOKEN=REMPLACER_PAR_TON_TOKEN

# Dépôt qui héberge le workflow .github/workflows/build-apk.yml et android-template/
GITHUB_OWNER=mon-org-ou-user
GITHUB_REPO=android-builder

# Fichier de workflow et branche (valeurs par défaut ci-dessous)
GITHUB_WORKFLOW=build-apk.yml
GITHUB_REF=main

# Dossier où les APK produits sont écrits
RELEASES_DIR=releases

# Dossier des miniatures (screenshots générés par Chrome headless)
THUMBS_DIR=thumbs
# Optionnel : chemin vers Chrome si non détecté automatiquement
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# Fichier SQLite (builds + historique par utilisateur)
DB_PATH=data.db

# Connexion Google (optionnelle) : historique de builds privé par compte.
# Laisser vide désactive la connexion (l'app fonctionne comme avant, historique
# local au navigateur). Client OAuth DÉDIÉ à créer sur https://console.cloud.google.com
# (Identifiants > Créer des identifiants > ID client OAuth > Application Web),
# avec BASE_URL + "/auth/google/callback" comme URI de redirection autorisée.
# Noms préfixés LOGIN_ pour ne pas entrer en collision si ce .env sert aussi à
# une autre app/fonctionnalité utilisant déjà GOOGLE_CLIENT_ID/SECRET.
BASE_URL=http://localhost:8080
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
# Signe les cookies de session ; auto-généré si absent (sessions perdues au
# redémarrage du serveur). À fixer en production pour rester connecté entre deux redémarrages.
# SESSION_SECRET=
